{
    "name": "dmcs-mis",
    "version": "1.0.0",
    "description": "Digital Marriage and Church Service Management Information System",
    "main": "server/index.js",
    "scripts": {
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "server": "cd server && npm run dev",
        "client": "cd client && npm start",
        "build": "cd client && npm run build",
        "install-all": "npm install && cd server && npm install && cd ../client && npm install",
        "start": "cd server && npm start",
        "setup": "node setup.js"
    },
    "keywords": [
        "marriage",
        "church",
        "management",
        "react",
        "nodejs",
        "express"
    ],
    "author": "DMCS MIS Team",
    "license": "MIT",
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}
